      "novel alert start",
      "IoU >= 0.20",
      "best IoU"
    ],
    "inference_unit": "cow; placements are repeated measurements nested within cow",
    "bootstrap_resamples": 10000,
    "paired_test": "exact one-sided sign-flip test on cow-level mean differences",
    "scenarios": [
      {
        "name": "abrupt_persistent",
        "duration_hours": 48,
        "expected_alert": 1,
        "description": "Abrupt onset and persistent multichannel decline."
      },
      {
        "name": "desynchronized_families",
        "duration_hours": 60,
        "expected_alert": 1,
        "description": "Decline with 0, 8, 12 and 16 hour onset lags across signal families."
      },
      {
        "name": "asymmetric_recovery",
        "duration_hours": 60,
        "expected_alert": 1,
        "description": "Fast onset followed by a slow recovery."
      },
      {
        "name": "noisy_gradual",
        "duration_hours": 48,
        "expected_alert": 1,
        "description": "Gradual decline perturbed by deterministic seeded noise."
      },
      {
        "name": "contiguous_dropout",
        "duration_hours": 60,
        "expected_alert": 1,
        "description": "Gradual decline with a contiguous 12 hour raw-data dropout."
      },
      {
        "name": "single_family_only",
        "duration_hours": 48,
        "expected_alert": 0,
        "description": "Negative control: dose-matched decline in steps only."
      }
    ]
  },
